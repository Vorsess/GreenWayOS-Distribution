class InstallationScreen(QWidget):
    """Installation progress screen"""
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.install_thread = None
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        
        # Title
        title = QLabel(get_text("installing", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        layout.addWidget(title)
        
        # Progress
        self.progress_bar = QProgressBar()
        self.progress_bar.setMaximum(100)
        self.progress_bar.setStyleSheet("QProgressBar { border: 2px solid #ddd; border-radius: 5px; }")
        layout.addWidget(self.progress_bar)
        
        # Current step
        self.step_label = QLabel()
        self.step_label.setFont(QFont("Sans", 12))
        layout.addWidget(self.step_label)
        
        # Log
        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)
        layout.addWidget(self.log_text)
        
        self.setLayout(layout)
    
    def on_show(self):
        """Start installation when shown"""
        if self.install_thread is None or not self.install_thread.is_alive():
            self.log_text.clear()
            self.progress_bar.setValue(0)
            # TODO: Start installation in thread
            self.parent.show_screen("done")

