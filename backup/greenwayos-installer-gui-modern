class DiskSelectionScreen(QWidget):
    """Disk selection screen"""
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.selected_disk = None
        self.disks = []
        self.setup_ui()
        self.refresh_disks()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        
        # Title
        title = QLabel(get_text("select_disk", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        layout.addWidget(title)
        
        # Disk table
        self.table = QTableWidget()
        self.table.setColumnCount(5)
        self.table.setHorizontalHeaderLabels([
            get_text("device", self.lang),
            get_text("size", self.lang),
            get_text("model", self.lang),
            get_text("status", self.lang),
            ""
        ])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.setSelectionBehavior(QTableWidget.SelectRows)
        self.table.setSelectionMode(QTableWidget.SingleSelection)
        layout.addWidget(self.table)
        
        # Buttons
        btn_layout = QHBoxLayout()
        btn_refresh = QPushButton("🔄 " + get_text("next", self.lang))
        btn_refresh.setMinimumHeight(50)
        btn_refresh.setFont(QFont("Sans", 12, QFont.Bold))
        btn_refresh.setStyleSheet("background-color: #1DB954; color: white; border: none; border-radius: 5px;")
        btn_refresh.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_refresh)
        
        btn_back = QPushButton(get_text("back", self.lang))
        btn_back.setMinimumHeight(50)
        btn_back.setFont(QFont("Sans", 12))
        btn_back.setStyleSheet("background-color: #333; color: white; border: none; border-radius: 5px;")
        btn_back.clicked.connect(lambda: self.parent.show_screen("welcome"))
        btn_layout.addWidget(btn_back)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def refresh_disks(self):
        """Load disks into table"""
        self.disks = get_disks()
        self.table.setRowCount(len(self.disks))
        
        for i, disk in enumerate(self.disks):
            ok, msg, _ = check_disk_space(disk.device)
            status = "✓ OK" if ok else "✗ Too small"
            status_color = "#1DB954" if ok else "#FF6B6B"
            
            item_dev = QTableWidgetItem(disk.device)
            item_size = QTableWidgetItem(f"{disk.size_gb:.1f} GB")
            item_model = QTableWidgetItem(disk.model[:40])
            item_status = QTableWidgetItem(status)
            item_status.setForeground(QColor(status_color))
            
            self.table.setItem(i, 0, item_dev)
            self.table.setItem(i, 1, item_size)
            self.table.setItem(i, 2, item_model)
            self.table.setItem(i, 3, item_status)
        
        if not self.disks:
            QMessageBox.warning(self, get_text("error", self.lang), 
                              get_text("no_disks", self.lang))
    
    def on_next(self):
        """Handle next button"""
        selected_rows = self.table.selectedIndexes()
        if not selected_rows:
            QMessageBox.warning(self, get_text("error", self.lang),
                              get_text("please_select_disk", self.lang))
            return
        
        row = selected_rows[0].row()
        disk = self.disks[row]
        ok, msg, _ = check_disk_space(disk.device)
        if not ok:
            QMessageBox.critical(self, get_text("error", self.lang), 
                               msg)
            return
        
        self.parent.state["disk"] = disk.device
        self.parent.show_screen("partitioning")

