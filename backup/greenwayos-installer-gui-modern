        btn_next.setStyleSheet("background-color: #1DB954; color: white; border: none; border-radius: 5px;")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)
        
        btn_back = QPushButton(get_text("back", self.lang))
        btn_back.setMinimumHeight(50)
        btn_back.setFont(QFont("Sans", 12))
        btn_back.setStyleSheet("background-color: #333; color: white; border: none; border-radius: 5px;")
        btn_back.clicked.connect(lambda: self.parent.show_screen("locale"))
        btn_layout.addWidget(btn_back)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def on_next(self):
        """Validate and save user data"""
        hostname = self.hostname_edit.text().strip()
        username = self.username_edit.text().strip()
        password = self.password_edit.text()
        confirm = self.confirm_edit.text()
        
        if not hostname or not username or not password:
            QMessageBox.warning(self, get_text("error", self.lang),
                              "All fields are required")
            return
        
        if password != confirm:
            QMessageBox.warning(self, get_text("error", self.lang),
                              get_text("passwords_mismatch", self.lang))
            return
        
        self.parent.state.update({
            "hostname": hostname,
            "username": username,
            "password": password,
            "expert_mode": False,
            "expert_profile": "standard",
            "install_ssh": False,
            "hardening_level": "none"
        })
        self.parent.show_screen("confirm")

