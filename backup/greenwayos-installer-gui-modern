class InstallerApp(QMainWindow):
    """Main installer application"""
    def __init__(self, lang="ru"):
        super().__init__()
        self.lang = lang
        self.state = {}
        
        self.setWindowTitle(get_text("title", lang))
        self.setGeometry(0, 0, 1024, 768)
        
        # Set style
        self.setStyleSheet("""
            QMainWindow { background-color: #1A1A1A; }
            QWidget { background-color: #1A1A1A; color: #FFFFFF; }
            QLineEdit, QComboBox, QSpinBox { 
                background-color: #2D2D2D; 
                color: #FFFFFF; 
                padding: 5px; 
                border: 2px solid #444;
                border-radius: 4px;
            }
            QLineEdit:focus, QComboBox:focus { border: 2px solid #1DB954; }
            QTableWidget {
                background-color: #2D2D2D;
                alternate-background-color: #252525;
            }
            QTableWidget::item { padding: 5px; }
            QTableWidget::item:selected { background-color: #1DB954; }
            QGroupBox { color: #FFFFFF; border: 2px solid #444; padding: 10px; }
            QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
            QPushButton { padding: 8px; }
            QTextEdit { background-color: #2D2D2D; border: 2px solid #444; border-radius: 4px; }
        """)
        
        # Central widget with stacked layout
        self.stacked = QStackedWidget()
        self.setCentralWidget(self.stacked)
        
        # Create screens
        self.screens = {
            "welcome": WelcomeScreen(self, lang),
            "disk": DiskSelectionScreen(self, lang),
            "partitioning": PartitioningScreen(self, lang),
            "locale": LocaleScreen(self, lang),
            "user": UserScreen(self, lang),
            "confirm": ConfirmScreen(self, lang),
            "install": InstallationScreen(self, lang),
            "done": DoneScreen(self, lang),
        }
        
        for screen in self.screens.values():
            self.stacked.addWidget(screen)
        
        self.show_screen("welcome")
    
    def show_screen(self, name: str):
        """Show a screen by name"""
        if name in self.screens:
            screen = self.screens[name]
            if hasattr(screen, 'on_show'):
                screen.on_show()
            self.stacked.setCurrentWidget(screen)
    
    def closeApplication(self):
        """Close application"""
        reply = QMessageBox.question(self, get_text("quit", self.lang),
                                    "Вы уверены что хотите выйти из установщика?",
                                    QMessageBox.Yes | QMessageBox.No)
        if reply == QMessageBox.Yes:
            self.close()

# ── Entry Point ───────────────────────────────────────────────────

if __name__ == "__main__":
    # Detect language from system
    lang = "ru" if os.environ.get("LANG", "").startswith("ru") else "en"
    
    app = QApplication(sys.argv)
    window = InstallerApp(lang)
    window.showMaximized()
    sys.exit(app.exec_())
