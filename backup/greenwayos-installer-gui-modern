class DiskInfo:
    """Information about a disk"""
    def __init__(self, device: str, size_gb: float, model: str, disk_type: str = "disk"):
        self.device = device
        self.size_gb = size_gb
        self.model = model
        self.disk_type = disk_type
        self.partitions: List[str] = []
    
    def __str__(self):
        return f"{self.device} ({self.size_gb:.1f}GB) - {self.model}"

def get_live_boot_disk() -> Optional[str]:
    """Get device path of live boot disk"""
    try:
        src = subprocess.check_output(
            ["findmnt", "-n", "-o", "SOURCE", "/run/live/medium"],
            text=True, stderr=subprocess.DEVNULL, timeout=3
        ).strip()
        if not src:
            return None
        parent = subprocess.check_output(
            ["lsblk", "-no", "PKNAME", src],
            text=True, stderr=subprocess.DEVNULL, timeout=3
        ).strip()
        return f"/dev/{parent}" if parent else (src if src.startswith("/dev/") else None)
    except Exception:
        return None

def get_disks() -> List[DiskInfo]:
    """Get list of available disks"""
    disks = []
    live_disk = get_live_boot_disk()
    try:
        output = subprocess.check_output(
            ["lsblk", "-d", "-o", "NAME,SIZE,MODEL,TYPE", "--noheadings"],
            text=True, stderr=subprocess.DEVNULL
        ).strip().splitlines()
        for line in output:
            parts = line.split(None, 3)
            if len(parts) >= 4 and parts[3].strip() == "disk":
                dev = f"/dev/{parts[0]}"
                if live_disk and dev == live_disk:
                    continue
                size_str = parts[1]
                size_gb = parse_size(size_str)
                model = parts[2].strip() if len(parts) > 2 else "Unknown"
                disks.append(DiskInfo(dev, size_gb, model))
    except Exception:
        pass
    return disks

def parse_size(size_str: str) -> float:
    """Parse size string (1.5T, 500G, 100M) to GB"""
    size_str = size_str.upper().strip()
    multipliers = {"T": 1024, "G": 1, "M": 1/1024, "K": 1/(1024*1024), "B": 1/(1024**3)}
    for unit, mult in multipliers.items():
        if size_str.endswith(unit):
            try:
                return float(size_str[:-1]) * mult
            except ValueError:
                pass
    return 0

def check_disk_space(disk: str, required_gb: int = 20) -> Tuple[bool, str, float]:
    """Check if disk has enough space"""
    try:
        result = subprocess.run(
            ["blockdev", "--getsize64", disk],
            capture_output=True, text=True, check=True, timeout=5
        )
        size_bytes = int(result.stdout.strip())
        size_gb = size_bytes / (1024 ** 3)
        if size_gb < required_gb:
            return False, f"Disk too small: {size_gb:.1f}GB (need {required_gb}GB)", size_gb
        return True, f"Disk OK: {size_gb:.1f}GB", size_gb
    except Exception as e:
        return False, f"Error checking disk: {e}", 0

def detect_boot_mode() -> str:
    """Detect UEFI or BIOS mode"""
    return "uefi" if os.path.exists("/sys/firmware/efi") else "bios"

