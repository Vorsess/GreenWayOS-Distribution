# ════════════════════════════════════════════════════════════════════
#  GreenWayOS Base Package List
#  Core system packages for all profiles
# ════════════════════════════════════════════════════════════════════

# System utilities
vim
htop
curl
wget
git
rsync
parted
lshw
pciutils
usbutils
inxi

# Core tools
build-essential
gcc
gdb
valgrind
strace
lsof
psmisc

# Python
python3
python3-dev
python3-pip
python3-tk
# Graphical installer (greenwayos-installer-gui) — must be in every ISO
python3-pyqt5

# Crypto/utilities used by installer (password hashing)
openssl

# Installers (text + graphical)
debootstrap
dosfstools
e2fsprogs
python3-curses
x11-xserver-utils
kbd
fbset
fonts-terminus
# Standalone X11 for graphical installer (must not depend only on gui/desktop lists)
xorg
xserver-xorg
xserver-xorg-video-vmware
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xauth
dbus-x11
fonts-dejavu
fontconfig
xfonts-base
xfonts-scalable
libgl1
libgl1-mesa-dri

fonts-hack-ttf

# Shells and terminals
bash
zsh

# Network base
curl
wget
iproute2
iputils-ping
traceroute
dnsutils
whois
netcat-openbsd
# Wi-Fi during install (text + graphical installers use nmcli)
network-manager
wireless-tools
rfkill
wpasupplicant

# Firewall
iptables
ufw

# VPN and tunneling
openvpn

# System monitoring
sysstat
atop
iotop
nethogs

# GRUB in chroot: BIOS (grub-pc). UEFI загрузчик для ISO подставляет live-build на binary-этапе,
# когда в auto/config задано --bootloaders "grub-pc grub-efi" (см. Debian Live Manual).
grub-pc
grub-common

# Debian Live userland (должно быть в базовом списке, а не только в «профильных» наборах)
live-boot
live-config
live-config-systemd

# Ядро и initramfs: не дублируем в списках — их подключает live-build через
# lb chroot_linux-image при --linux-flavours amd64 в auto/config (избегаем двойной установки).

# Localization
locales
tzdata
