class NetworkScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self._wifi_nets = []
        self._selected_ssid = ""
        self.setup_ui()

    def setup_ui(self):
        compact = getattr(self.parent, "compact_mode", False)
        layout = QVBoxLayout()
        margin = 16 if compact else 28
        layout.setContentsMargins(margin, margin, margin, margin)
        layout.setSpacing(10 if compact else 14)

        title = QLabel(get_text("network_config", self.lang))
        title.setFont(QFont("Sans", 20 if compact else 24, QFont.Bold))
        title.setStyleSheet("color: #1DB954;")
        layout.addWidget(title)

        self.status_label = QLabel(network_status_summary())
        self.status_label.setStyleSheet("color: #79C0FF; font-size: 12px;")
        layout.addWidget(self.status_label)

        method_group = QGroupBox(get_text("network_type", self.lang))
        method_layout = QVBoxLayout()
        self.method_group = QButtonGroup(self)

        self.radio_local = QRadioButton(get_text("network_local", self.lang))
        self.radio_local.setChecked(True)
        self.radio_wifi = QRadioButton(get_text("network_wifi", self.lang))
        self.method_group.addButton(self.radio_local, 0)
        self.method_group.addButton(self.radio_wifi, 1)
        method_layout.addWidget(self.radio_local)

        local_hint = QLabel(get_text("network_local_hint", self.lang))
        local_hint.setWordWrap(True)
        local_hint.setStyleSheet("color: #8B949E; font-size: 11px; margin-left: 22px;")
        method_layout.addWidget(local_hint)

        method_layout.addWidget(self.radio_wifi)
        wifi_hint = QLabel(get_text("network_wifi_hint", self.lang))
        wifi_hint.setWordWrap(True)
        wifi_hint.setStyleSheet("color: #8B949E; font-size: 11px; margin-left: 22px;")
        method_layout.addWidget(wifi_hint)
        method_group.setLayout(method_layout)
        layout.addWidget(method_group)

        self.wifi_panel = QFrame()
        wifi_layout = QVBoxLayout(self.wifi_panel)
        wifi_layout.setContentsMargins(0, 4, 0, 0)
        wifi_layout.setSpacing(8)

        wifi_header = QHBoxLayout()
        wifi_header.addWidget(QLabel(get_text("wifi_networks", self.lang)))
        wifi_header.addStretch()
        self.btn_scan = create_gradient_button(get_text("wifi_scan", self.lang), "secondary", "↻")
        self.btn_scan.clicked.connect(self.scan_networks)
        wifi_header.addWidget(self.btn_scan)
        wifi_layout.addLayout(wifi_header)

        self.wifi_list = QListWidget()
        self.wifi_list.setMinimumHeight(100 if compact else 140)
        self.wifi_list.setMaximumHeight(180 if compact else 220)
        self.wifi_list.itemSelectionChanged.connect(self._on_wifi_selected)
        wifi_layout.addWidget(self.wifi_list)

        wifi_layout.addWidget(QLabel(get_text("wifi_password", self.lang)))
        self.wifi_password = QLineEdit()
        self.wifi_password.setEchoMode(QLineEdit.Password)
        self.wifi_password.setPlaceholderText("••••••••")
        wifi_layout.addWidget(self.wifi_password)

        self.btn_connect = create_gradient_button(get_text("wifi_connect", self.lang), "primary", "📡")
        self.btn_connect.clicked.connect(self.connect_selected)
        wifi_layout.addWidget(self.btn_connect)

        layout.addWidget(self.wifi_panel)
        self.wifi_panel.setVisible(False)

        self.radio_local.toggled.connect(self._on_method_changed)
        self.radio_wifi.toggled.connect(self._on_method_changed)

        layout.addStretch()

        btn_test = create_gradient_button(get_text("test_connection", self.lang), "secondary", "🔗")
        btn_test.clicked.connect(self.test_network)
        layout.addWidget(btn_test)

        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)

        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.clicked.connect(lambda: self.parent.show_screen("welcome"))
        btn_layout.addWidget(btn_back)
        btn_layout.addStretch()

        btn_next = create_gradient_button(get_text("next", self.lang), "primary", "→")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)

        layout.addLayout(btn_layout)
        self.setLayout(layout)

    def _on_method_changed(self):
        wifi = self.radio_wifi.isChecked()
        self.wifi_panel.setVisible(wifi)
        if wifi and self.wifi_list.count() == 0:
            from PyQt5.QtCore import QTimer
            QTimer.singleShot(200, self.scan_networks)

    def _on_wifi_selected(self):
        item = self.wifi_list.currentItem()
        if not item:
            self._selected_ssid = ""
            return
        self._selected_ssid = item.data(Qt.UserRole) or ""

    def refresh_status(self):
        self.status_label.setText(
            f"{get_text('network_status', self.lang)}: {network_status_summary()}"
        )

    def scan_networks(self):
        self.btn_scan.setEnabled(False)
        self.wifi_list.clear()
        self.wifi_list.addItem(get_text("wifi_scanning", self.lang))
        QApplication.processEvents()
        try:
            nets = scan_wifi(rescan=True)
        except Exception as exc:
            nets = []
            if logger:
                logger.exception("Wi-Fi scan failed: %s", exc)
        self.wifi_list.clear()
        self._wifi_nets = nets
        if not nets:
            self.wifi_list.addItem(get_text("wifi_no_networks", self.lang))
        else:
            for n in nets:
                mark = "★ " if n.get("in_use") else ""
                text = f"{mark}{n['ssid']}  ({n['signal']}%)  {n.get('security') or '--'}"
                item = QListWidgetItem(text)
                item.setData(Qt.UserRole, n["ssid"])
                self.wifi_list.addItem(item)
        self.btn_scan.setEnabled(True)
        self.refresh_status()

    def connect_selected(self):
        if not self._selected_ssid:
            QMessageBox.warning(
                self, get_text("error", self.lang), get_text("wifi_select_first", self.lang)
            )
            return
        net = next((n for n in self._wifi_nets if n["ssid"] == self._selected_ssid), None)
        password = self.wifi_password.text()
        need_pass = bool(net and net.get("security") not in ("", "--", "None", None))
        if need_pass and not password:
            QMessageBox.warning(
                self, get_text("error", self.lang), get_text("wifi_need_password", self.lang)
            )
            return

        self.btn_connect.setEnabled(False)
        self.status_label.setText(get_text("wifi_connecting", self.lang))
        QApplication.processEvents()
        ok, msg = connect_wifi(self._selected_ssid, password or None)
        self.btn_connect.setEnabled(True)
        self.refresh_status()
        if ok:
            QMessageBox.information(self, get_text("success", self.lang), msg)
            self.parent.state.update({
                "network_mode": "wifi",
                "network_type": "dhcp",
                "wifi_ssid": self._selected_ssid,
            })
        else:
            QMessageBox.warning(self, get_text("error", self.lang), msg)

    def test_network(self):
        self.refresh_status()
        if check_internet():
            QMessageBox.information(
                self, get_text("success", self.lang), get_text("connection_ok", self.lang)
            )
        else:
            QMessageBox.warning(
                self, get_text("error", self.lang), get_text("connection_failed", self.lang)
            )

    def on_next(self):
        if self.radio_local.isChecked():
            self.parent.state.update({
                "network_mode": "local",
                "network_type": "dhcp",
                "wifi_ssid": "",
            })
            self.parent.show_screen("disk")
            return

        # Wi-Fi selected: allow continue if already connected or user connected earlier
        if self.parent.state.get("network_mode") == "wifi" and self.parent.state.get("wifi_ssid"):
            self.parent.show_screen("disk")
            return

        if self._selected_ssid:
            self.connect_selected()
            if self.parent.state.get("network_mode") == "wifi":
                self.parent.show_screen("disk")
            return

        QMessageBox.warning(
            self, get_text("error", self.lang), get_text("wifi_select_first", self.lang)
        )

    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

class LocaleScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        
        title = QLabel(get_text("select_locale", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        layout.addWidget(title)
        
        tz_label = QLabel(get_text("timezone", self.lang))
        self.tz_combo = QComboBox()
        timezones = [
            "Europe/Moscow", "Europe/Samara", "Europe/Kaliningrad",
            "UTC", "Asia/Yekaterinburg", "Asia/Novosibirsk", "Asia/Vladivostok"
        ]
        self.tz_combo.addItems(timezones)
        self.tz_combo.setCurrentText("Europe/Moscow" if self.lang == "ru" else "UTC")
        layout.addWidget(tz_label)
        layout.addWidget(self.tz_combo)
        
        lang_label = QLabel(get_text("language", self.lang))
        self.lang_combo = QComboBox()
        self.lang_combo.addItems(["ru_RU.UTF-8", "en_US.UTF-8"])
        self.lang_combo.setCurrentText("ru_RU.UTF-8" if self.lang == "ru" else "en_US.UTF-8")
        layout.addWidget(lang_label)
        layout.addWidget(self.lang_combo)
        
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.clicked.connect(lambda: self.parent.show_screen("options"))
        btn_layout.addWidget(btn_back)
        
        btn_layout.addStretch()
        
        btn_next = create_gradient_button(get_text("next", self.lang), "primary", "→")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def on_next(self):
        self.parent.state["timezone"] = self.tz_combo.currentText()
        self.parent.state["locale"] = self.lang_combo.currentText()
        self.parent.show_screen("user")
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

class UserScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        layout.setSpacing(10)
        
        title_layout = QHBoxLayout()
        title = QLabel(get_text("create_user", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        title_layout.addWidget(title)
        
        help_btn = QPushButton("?")
        help_btn.setMaximumWidth(40)
        help_btn.setMaximumHeight(40)
        help_btn.setStyleSheet("background-color: #1DB954; color: white; font-weight: bold;")
        help_btn.clicked.connect(lambda: QMessageBox.information(self, get_text("help", self.lang),
            "Create a user account for system login."))
        title_layout.addStretch()
        title_layout.addWidget(help_btn)
        layout.addLayout(title_layout)
        
        layout.addWidget(QLabel(get_text("hostname", self.lang)))
        self.hostname_edit = QLineEdit()
        self.hostname_edit.setText("greenwayos")
        self.hostname_edit.setToolTip(get_text("hostname_tooltip", self.lang))
        layout.addWidget(self.hostname_edit)
        
        layout.addWidget(QLabel(get_text("username", self.lang)))
        self.username_edit = QLineEdit()
        self.username_edit.setText("user")
        self.username_edit.setToolTip(get_text("username_tooltip", self.lang))
        layout.addWidget(self.username_edit)
        
        layout.addWidget(QLabel(get_text("password", self.lang)))
        self.password_edit = QLineEdit()
        self.password_edit.setEchoMode(QLineEdit.Password)
        self.password_edit.setToolTip(get_text("password_tooltip", self.lang))
        self.password_edit.textChanged.connect(self.update_password_strength)
        layout.addWidget(self.password_edit)
        
        strength_layout = QHBoxLayout()
        strength_layout.addWidget(QLabel(get_text("password_strength", self.lang) + ":"))
        self.strength_label = QLabel(get_text("weak", self.lang))
        self.strength_label.setStyleSheet("color: #FF6B6B; font-weight: bold;")
        strength_layout.addWidget(self.strength_label)
        strength_layout.addStretch()
        layout.addLayout(strength_layout)
        
        self.strength_bar = QProgressBar()
        self.strength_bar.setMaximum(10)
        self.strength_bar.setMaximumHeight(8)
        layout.addWidget(self.strength_bar)
        
        layout.addWidget(QLabel(get_text("confirm_password", self.lang)))
        self.confirm_edit = QLineEdit()
        self.confirm_edit.setEchoMode(QLineEdit.Password)
        layout.addWidget(self.confirm_edit)
        
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.clicked.connect(lambda: self.parent.show_screen("locale"))
        btn_layout.addWidget(btn_back)
        
        btn_layout.addStretch()
        
        btn_next = create_gradient_button(get_text("next", self.lang), "primary", "→")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def update_password_strength(self):
        password = self.password_edit.text()
        strength, score = check_password_strength(password)
        
        strength_text = {
            "weak": get_text("weak", self.lang),
            "medium": get_text("medium", self.lang),
            "strong": get_text("strong", self.lang)
        }
        
        strength_colors = {
            "weak": "#FF6B6B",
            "medium": "#FFB84D",
            "strong": "#1DB954"
        }
        
        self.strength_label.setText(strength_text[strength])
        self.strength_label.setStyleSheet(f"color: {strength_colors[strength]}; font-weight: bold;")
        self.strength_bar.setValue(score)
        self.strength_bar.setStyleSheet(f"""
            QProgressBar {{
                border: 1px solid #444;
                background-color: #2D2D2D;
            }}
            QProgressBar::chunk {{
                background-color: {strength_colors[strength]};
            }}
        """)
    
    def on_next(self):
        hostname = self.hostname_edit.text().strip().lower() or "greenwayos"
        username = self.username_edit.text().strip().lower()
        password = self.password_edit.text()
        confirm = self.confirm_edit.text()
        
        ok, msg = validate_hostname(hostname)
        if not ok:
            QMessageBox.warning(self, get_text("error", self.lang), msg)
            return
        
        ok, msg = validate_username(username)
        if not ok:
            QMessageBox.warning(self, get_text("error", self.lang), msg)
            return
        
        if not password:
            QMessageBox.warning(self, get_text("error", self.lang),
                              get_text("all_fields_required", self.lang))
            return
        
        strength, _ = check_password_strength(password)
        if strength == "weak":
            reply = QMessageBox.warning(self, get_text("error", self.lang),
                get_text("weak_password", self.lang),
                QMessageBox.Yes | QMessageBox.No)
            if reply == QMessageBox.No:
                return
        
        if password != confirm:
            QMessageBox.warning(self, get_text("error", self.lang),
                              get_text("passwords_mismatch", self.lang))
            return
        
        self.parent.state.update({
            "hostname": hostname,
            "username": username,
            "password": password,
        })
        self.parent.show_screen("confirm")
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

class ConfirmScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        
        title = QLabel(get_text("confirm_installation", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        layout.addWidget(title)
        
        self.summary_text = QTextEdit()
        self.summary_text.setReadOnly(True)
        self.summary_text.setMinimumHeight(200)
        layout.addWidget(self.summary_text)
        
        warning = QLabel(get_text("warning_data_loss", self.lang))
        warning.setFont(QFont("Sans", 12, QFont.Bold))
        warning.setStyleSheet("color: #FF6B6B;")
        warning.setWordWrap(True)
        self.warning_label = warning
        layout.addWidget(warning)
        
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_save = create_gradient_button(get_text("save_config", self.lang), "secondary", "💾")
        btn_save.clicked.connect(self.save_config_file)
        btn_layout.addWidget(btn_save)
        
        btn_layout.addStretch()
        
        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.clicked.connect(lambda: self.parent.show_screen("user"))
        btn_layout.addWidget(btn_back)
        
        btn_install = create_gradient_button(get_text("install", self.lang), "primary", "⚙️")
        btn_install.setMinimumHeight(60)
        btn_install.clicked.connect(self.on_install)
        btn_layout.addWidget(btn_install)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def save_config_file(self):
        if save_config(self.parent.state):
            QMessageBox.information(self, get_text("success", self.lang),
                                  get_text("config_saved", self.lang))
        else:
            QMessageBox.warning(self, get_text("error", self.lang),
                              "Failed to save configuration")
    
    def on_show(self):
        state = self.parent.state
        
        profile_id = state.get('profile', '?')
        profile_display = PROFILES.get(profile_id, {}).get('name', profile_id)
        
        options = []
        if state.get('install_ssh'):
            options.append("SSH Server")
        if state.get('install_docker'):
            options.append("Docker")
        if state.get('enable_firewall'):
            options.append("Firewall")
        options_str = ", ".join(options) if options else "None"
        
        summary = f"""
ПАРАМЕТРЫ УСТАНОВКИ / INSTALLATION SETTINGS

Диск / Disk: {state.get('disk', '?')}
Разметка / Layout: {state.get('partition_method', 'quick')}
Сеть / Network: {state.get('network_mode', 'local')}{(' / Wi-Fi: ' + state['wifi_ssid']) if state.get('wifi_ssid') else ''}
Режим загрузки / Boot Mode: {state.get('boot_mode', '?').upper()}
Профиль / Profile: {profile_display}
Уровень безопасности / Security: {state.get('hardening_level', '?')}
Дополнительно / Extra: {options_str}

Часовой пояс / Timezone: {state.get('timezone', '?')}
Язык / Language: {state.get('locale', '?')}
Имя компьютера / Hostname: {state.get('hostname', '?')}
Пользователь / Username: {state.get('username', '?')}
        """
        self.summary_text.setText(summary)

        if state.get("partition_method") == "dualboot":
            self.warning_label.setText(get_text("warning_dualboot_keep", self.lang))
            self.warning_label.setStyleSheet("color: #1DB954;")
        else:
            self.warning_label.setText(get_text("warning_data_loss", self.lang))
            self.warning_label.setStyleSheet("color: #FF6B6B;")
    
    def on_install(self):
        self.parent.show_screen("install")
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

# ── Installation Thread ─────────────────────────────────────────────

class InstallationThread(QThread):
    progress_changed = pyqtSignal(int)
    log_message = pyqtSignal(str)
    step_changed = pyqtSignal(str)
    finished = pyqtSignal(bool, str)
    
    def __init__(self, parent_app):
        super().__init__()
        self.app = parent_app
        self.log_file = "/var/log/greenwayos-install.log"
        self.target = "/target"
        
        self.log_f = None
    
    def write_log(self, message: str):
        self.log_message.emit(message)
    
    def __del__(self):
        if hasattr(self, 'log_f') and self.log_f:
            try:
                self.log_f.close()
            except:
                pass
    
    def run_cmd(self, cmd: list, timeout: int = 300, check: bool = False) -> Tuple[bool, str, str]:
        """Run a command and return (success, stdout, stderr)"""
        try:
            self.write_log(f"  Running: {' '.join(cmd)}")
            result = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False
            )
            if result.returncode != 0 and check:
                self.write_log(f"  ERROR: Command failed with code {result.returncode}")
                self.write_log(f"  stderr: {result.stderr[:200]}")
                return False, result.stdout, result.stderr
            return True, result.stdout, result.stderr
        except subprocess.TimeoutExpired:
            self.write_log(f"  ERROR: Command timed out after {timeout}s")
            return False, "", f"Timeout after {timeout}s"
        except Exception as e:
            self.write_log(f"  ERROR: {str(e)}")
            return False, "", str(e)
    
    def validate_setup(self) -> bool:
        """Validate that all required state is present"""
        state = self.app.state
        
        if not state.get('disk'):
            self.write_log("FATAL: No disk selected")
            return False
        
        if not os.path.exists(state['disk']):
            self.write_log(f"FATAL: Selected disk {state['disk']} does not exist")
            return False
        
        required = ['hostname', 'username', 'password', 'timezone', 'locale', 'boot_mode']
        for key in required:
            if not state.get(key):
                self.write_log(f"FATAL: Missing required state: {key}")
                return False
        
        return True
    
    def run(self):
        try:
            from install.engine import install_system
            from install.state import normalize_install_state

            if not self.validate_setup():
                self.finished.emit(False, "Validation failed - check log")
                return

            state = normalize_install_state(self.app.state)
            outcome = {"ok": False, "err": None}

            def progress_cb(pct, step_label):
                self.progress_changed.emit(pct)
                self.step_changed.emit(step_label)

            def log_cb(msg):
                self.write_log(msg)

            def done_cb():
                outcome["ok"] = True

            def error_cb(err):
                outcome["err"] = err

            self.write_log(f"GreenWayOS Installation — log: {self.log_file}")
            install_system(state, progress_cb, log_cb, done_cb, error_cb)

            if outcome["ok"]:
                self.progress_changed.emit(100)
                self.step_changed.emit(get_text("finalizing", self.app.lang))
                self.finished.emit(True, "Installation complete")
            else:
                self.finished.emit(False, outcome["err"] or "Installation failed")

        except Exception as e:
            self.write_log(f"CRITICAL ERROR: {str(e)}")
            self.finished.emit(False, f"Critical error: {str(e)}")
    
    def prepare_disk(self) -> Tuple[bool, str]:
        """Prepare disk for installation"""
        disk = self.app.state.get('disk', '')
        
        self.write_log(f"Preparing disk: {disk}")
        
        # Check if disk exists
        if not os.path.exists(disk):
            return False, f"Disk {disk} not found"
        
        # Check availability
        ok, msg, size = check_disk_space(disk)
        if not ok:
            return False, msg
        
        self.write_log(f"Disk size: {size:.1f} GB")
        
        # Unmount any mounted partitions
        self.write_log("Unmounting existing partitions...")
        for i in range(1, 20):
            part = f"{disk}{i}" if not disk[-1].isdigit() else f"{disk}p{i}"
            if os.path.exists(part):
                subprocess.run(["umount", "-f", part], capture_output=True, timeout=5, check=False)
        
        # Make sure disk is unmounted
        subprocess.run(["umount", "-f", disk], capture_output=True, timeout=5, check=False)
        
        self.write_log("Disk preparation complete")
        return True, ""
    
    def format_disk(self) -> Tuple[bool, str]:
        """Format disk with partition table and filesystem"""
        disk = self.app.state.get('disk', '')
        boot_mode = self.app.state.get('boot_mode', 'bios')
        
        self.write_log(f"Formatting {disk} for {boot_mode.upper()} boot")
        
        # Wipe filesystem signatures
        self.write_log("Wiping existing signatures...")
        success, out, err = self.run_cmd(
            ["wipefs", "-a", disk],
            timeout=60
        )
        
        # Create partition table
        part_table = "gpt" if boot_mode == "uefi" else "msdos"
        self.write_log(f"Creating {part_table.upper()} partition table...")
        success, out, err = self.run_cmd(
            ["parted", "-s", disk, "mklabel", part_table],
            timeout=30,
            check=True
        )
        if not success:
            return False, f"Failed to create partition table: {err}"
        
        # Create EFI partition for UEFI
        if boot_mode == "uefi":
            self.write_log("Creating EFI System Partition...")
            success, out, err = self.run_cmd(
                ["parted", "-s", disk, "mkpart", "primary", "fat32", "1MiB", "513MiB"],
                timeout=30,
                check=True
            )
            if not success:
                return False, f"Failed to create EFI partition: {err}"
            
            self.write_log("Setting ESP flag...")
            efi_part = f"{disk}1" if not disk[-1].isdigit() else f"{disk}p1"
            subprocess.run(["parted", "-s", disk, "set", "1", "esp", "on"], 
                         capture_output=True, timeout=10, check=False)
            
            # Create root partition
            self.write_log("Creating root partition...")
            success, out, err = self.run_cmd(
                ["parted", "-s", disk, "mkpart", "primary", "ext4", "513MiB", "100%"],
                timeout=30,
                check=True
            )
            if not success:
                return False, f"Failed to create root partition: {err}"
        else:
            # Create single root partition for BIOS
            self.write_log("Creating root partition...")
            success, out, err = self.run_cmd(
                ["parted", "-s", disk, "mkpart", "primary", "ext4", "1MiB", "100%"],
                timeout=30,
                check=True
            )
            if not success:
                return False, f"Failed to create root partition: {err}"
            
            # Set bootable flag
            subprocess.run(["parted", "-s", disk, "set", "1", "boot", "on"],
                         capture_output=True, timeout=10, check=False)
        
        # Wait for kernel to recognize partitions
        time.sleep(2)
        success, out, err = self.run_cmd(["partprobe", disk], timeout=10)
        
        # Format partitions
        if boot_mode == "uefi":
            efi_part = f"{disk}1" if not disk[-1].isdigit() else f"{disk}p1"
            root_part = f"{disk}2" if not disk[-1].isdigit() else f"{disk}p2"
            
            self.write_log(f"Formatting EFI partition {efi_part}...")
            success, out, err = self.run_cmd(
                ["mkfs.fat", "-F32", efi_part],
                timeout=30,
                check=True
            )
            if not success:
                return False, f"Failed to format EFI partition: {err}"
        else:
            root_part = f"{disk}1" if not disk[-1].isdigit() else f"{disk}p1"
        
        self.write_log(f"Formatting root partition {root_part}...")
        success, out, err = self.run_cmd(
            ["mkfs.ext4", "-F", root_part],
            timeout=60,
            check=True
        )
        if not success:
            return False, f"Failed to format root partition: {err}"
        
        # Store partition info in state
        if boot_mode == "uefi":
            self.app.state["root_partition"] = root_part
            self.app.state["efi_partition"] = efi_part
        else:
            self.app.state["root_partition"] = root_part
            self.app.state["efi_partition"] = None
        
        self.write_log("Formatting complete")
        return True, ""
    
    def install_base_system(self) -> Tuple[bool, str]:
        """Install base system using debootstrap"""
        disk = self.app.state.get('disk', '')
        root_part = self.app.state.get('root_partition', '')
        
        self.write_log(f"Installing base system to {root_part}")
        
        # Mount root partition
        try:
            os.makedirs(self.target, exist_ok=True)
        except:
            return False, f"Cannot create target directory {self.target}"
        
        # Mount
        self.write_log("Mounting root partition...")
        success, out, err = self.run_cmd(
            ["mount", root_part, self.target],
            timeout=10,
            check=True
        )
        if not success:
            return False, f"Failed to mount root partition: {err}"
        
        # If UEFI, mount ESP
        boot_dir = os.path.join(self.target, "boot")
        if self.app.state.get('efi_partition'):
            self.write_log("Mounting EFI partition...")
            efi_part = self.app.state['efi_partition']
            efi_dir = os.path.join(self.target, "boot/efi")
            os.makedirs(efi_dir, exist_ok=True)
            subprocess.run(["mount", efi_part, efi_dir], 
                         capture_output=True, timeout=10, check=False)
        
        # Check if debootstrap available
        if not shutil.which("debootstrap"):
            self.unmount_all()
            return False, "debootstrap not found. Install with: apt-get install debootstrap"
        
        # Run debootstrap
        self.write_log("Running debootstrap (this may take several minutes)...")
        success, out, err = self.run_cmd(
            ["debootstrap", "--variant=minbase", "bookworm", self.target, 
             "http://deb.debian.org/debian/"],
            timeout=1200,  # 20 minutes timeout
            check=True
        )
        if not success:
            self.write_log(f"debootstrap stderr: {err[:500]}")
            self.unmount_all()
            return False, f"debootstrap failed: {err[:200]}"
        
        self.write_log("Base system installed successfully")
        return True, ""
    
    def configure_system_chroot(self) -> Tuple[bool, str]:
        """Configure the system inside chroot"""
        state = self.app.state
        
        self.write_log("Configuring system in chroot...")
        
        # Mount virtual filesystems
        self.write_log("Mounting virtual filesystems...")
        for fs, path in [("proc", "/proc"), ("sysfs", "/sys"), ("devtmpfs", "/dev")]:
            target_path = os.path.join(self.target, path.lstrip("/"))
            subprocess.run(["mount", "--bind", path, target_path], 
                         capture_output=True, timeout=10, check=False)
        
        # Copy DNS info
        if os.path.exists("/etc/resolv.conf"):
            shutil.copy("/etc/resolv.conf", os.path.join(self.target, "etc/resolv.conf"))
        
        # Prepare chroot script
        chroot_script = self.generate_chroot_script()
        script_path = os.path.join(self.target, "tmp/configure.sh")
        
        with open(script_path, 'w') as f:
            f.write(chroot_script)
        os.chmod(script_path, 0o755)
        
        # Run chroot script
        self.write_log("Running chroot configuration script...")
        success, out, err = self.run_cmd(
            ["chroot", self.target, "/bin/bash", "/tmp/configure.sh"],
            timeout=600,
            check=True
        )
        if not success:
            self.write_log(f"Chroot script failed: {err[:500]}")
            cleanup = f"rm -f {script_path}"
            return False, f"Chroot configuration failed"
        
        # Cleanup
        os.remove(script_path)
        
        self.write_log("System configuration complete")
        return True, ""
    
    def generate_chroot_script(self) -> str:
        """Generate the chroot configuration script"""
        state = self.app.state
        hostname = state.get('hostname', 'greenwayos')
        username = state.get('username', 'user')
        password = state.get('password', '')
        timezone = state.get('timezone', 'UTC')
        locale_str = state.get('locale', 'en_US.UTF-8')
        
        # Generate password hash
        password_hash = self._generate_password_hash(password)
        
        packages = state.get('packages', [])
        package_list = " ".join(packages)
        
        script = f"""#!/bin/bash
set -e
set -x

# Set hostname
echo "{hostname}" > /etc/hostname
echo "127.0.1.1 {hostname}" >> /etc/hosts

# Set locale
echo "{locale_str} UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG={locale_str}

# Set timezone
ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime
echo "{timezone}" > /etc/timezone

# Update package lists
apt-get update

# Install essential packages
apt-get install -y --no-install-recommends \\
    linux-image-amd64 \\
    grub-pc \\
    network-manager \\
    sudo \\
    systemd \\
    dbus \\
    openssh-client || true

# Install profile packages
if [ -n "{package_list}" ]; then
    apt-get install -y --no-install-recommends {package_list} || true
fi

# Install SSH if requested
if [ "{'true' if state.get('install_ssh') else 'false'}" = "true" ]; then
    apt-get install -y openssh-server
fi

# Install Docker if requested
if [ "{'true' if state.get('install_docker') else 'false'}" = "true" ]; then
    apt-get install -y docker.io docker-compose
fi

# Enable firewall if requested
if [ "{'true' if state.get('enable_firewall') else 'false'}" = "true" ]; then
    apt-get install -y ufw
    ufw enable
fi

# Create user
useradd -m -s /bin/bash -G sudo {username}
echo '{username}:{password_hash}' | chpasswd -e

# Set root password
echo 'root:{password_hash}' | chpasswd -e

# Configure sudo
echo "{username} ALL=(ALL:ALL) NOPASSWD:ALL" > /etc/sudoers.d/{username}
chmod 440 /etc/sudoers.d/{username}

# Configure network
if [ "{state.get('network_type', 'dhcp')}" = "dhcp" ]; then
    cat > /etc/network/interfaces << 'EOF'
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOF
fi

# Clean up
apt-get clean
"""
        return script
    
    def _generate_password_hash(self, password: str) -> str:
        """Generate a SHA-512 password hash"""
        try:
            import crypt
            salt = crypt.mksalt(crypt.METHOD_SHA512)
            return crypt.crypt(password, salt)
        except:
            # Fallback to openssl
            try:
                result = subprocess.run(
                    ["openssl", "passwd", "-6", password],
                    capture_output=True, text=True, timeout=5, check=True
                )
                return result.stdout.strip()
            except:
                return password
    
    def install_bootloader(self) -> Tuple[bool, str]:
        """Install GRUB bootloader"""
        disk = self.app.state.get('disk', '')
        boot_mode = self.app.state.get('boot_mode', 'bios')
        
        self.write_log(f"Installing bootloader for {boot_mode.upper()}...")
        
        if boot_mode == "uefi":
            # Install GRUB EFI
            cmd = ["chroot", self.target, "grub-install", "--target=x86_64-efi",
                   "--efi-directory=/boot/efi", "--bootloader-id=GreenWayOS",
                   "--recheck"]
            success, out, err = self.run_cmd(cmd, timeout=60, check=True)
        else:
            # Install GRUB BIOS
            cmd = ["chroot", self.target, "grub-install", disk]
            success, out, err = self.run_cmd(cmd, timeout=60, check=True)
        
        if not success:
            return False, f"GRUB installation failed: {err}"
        
        # Update GRUB config
        self.write_log("Updating GRUB configuration...")
        success, out, err = self.run_cmd(
            ["chroot", self.target, "update-grub"],
            timeout=30,
            check=True
        )
        
        self.write_log("Bootloader installation complete")
        return True, ""
    
    def unmount_all(self):
        """Unmount all mounted filesystems"""
        self.write_log("Unmounting filesystems...")
        subprocess.run(["umount", "-R", self.target], capture_output=True, timeout=10, check=False)
        subprocess.run(["sync"], capture_output=True)
    
    def finalize(self):
        self.unmount_all()
        self.write_log("Installation finalization complete")

class InstallationScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.install_thread = None
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        layout.setSpacing(15)
        
        title = QLabel(get_text("installing", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        title.setStyleSheet("color: #1DB954;")
        layout.addWidget(title)
        
        self.progress_bar = QProgressBar()
        self.progress_bar.setMaximum(100)
        self.progress_bar.setMinimumHeight(30)
        layout.addWidget(self.progress_bar)
        
        self.step_label = QLabel()
        self.step_label.setFont(QFont("Sans", 11))
        self.step_label.setStyleSheet("color: #1DB954;")
        layout.addWidget(self.step_label)
        
        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)
        self.log_text.setFont(QFont("Monospace", 9))
        self.log_text.setStyleSheet("background-color: #1A1A1A; color: #0F0;")
        layout.addWidget(self.log_text)
        
        self.setLayout(layout)
    
    def on_show(self):
        if self.install_thread is None or not self.install_thread.isRunning():
            self.log_text.clear()
            self.progress_bar.setValue(0)
            self.step_label.setText(get_text("preparing_system", self.lang))
            
            self.install_thread = InstallationThread(self.parent)
            self.install_thread.progress_changed.connect(self.update_progress)
            self.install_thread.log_message.connect(self.add_log)
            self.install_thread.step_changed.connect(self.update_step)
            self.install_thread.finished.connect(self.installation_finished)
            self.install_thread.start()
    
    def update_progress(self, value: int):
        self.progress_bar.setValue(value)
    
    def add_log(self, message: str):
        self.log_text.append(message)
        scrollbar = self.log_text.verticalScrollBar()
        scrollbar.setValue(scrollbar.maximum())
    
    def update_step(self, step_name: str):
        self.step_label.setText(step_name)
    
    def installation_finished(self, success: bool, message: str):
        if success:
            self.parent.show_screen("done")
        else:
            QMessageBox.critical(self, get_text("error", self.lang),
                               f"Installation failed: {message}")
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

class DoneScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setSpacing(20)
        layout.setContentsMargins(40, 40, 40, 40)
        
        title = QLabel("✓ " + get_text("install_complete", self.lang))
        title.setFont(QFont("Sans", 32, QFont.Bold))
        title.setStyleSheet("color: #1DB954;")
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        
        message = QLabel("GreenWayOS успешно установлена на ваш компьютер!\n\nПожалуйста, перезагрузите систему.\n\nЛог установки: /var/log/greenwayos-install.log")
        message.setFont(QFont("Sans", 14))
        message.setAlignment(Qt.AlignCenter)
        layout.addWidget(message)
        
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_reboot = create_gradient_button(get_text("reboot", self.lang), "primary", "🔄")
        btn_reboot.setMinimumHeight(60)
        btn_reboot.clicked.connect(lambda: os.system("reboot"))
        btn_layout.addWidget(btn_reboot)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

# ── Main Application ───────────────────────────────────────────────

class InstallerApp(QMainWindow):
    def __init__(self, lang="ru"):
        super().__init__()
        self.lang = lang
        self.state = {}
        self.current_screen_index = 0
        self.screen_names_list = []
        
        self.setWindowTitle("GreenWayOS // INSTALL PROTOCOL")
        self.setStyleSheet(MODERN_STYLESHEET)

        screen = QApplication.primaryScreen()
        if screen:
            # Use availableGeometry to account for panels/taskbars, but respect full-screen mode
            geo = screen.availableGeometry()
            # Compact layout for anything at/under 1280x800 (installer default)
            compact = geo.height() <= 900 or geo.width() <= 1366
        else:
            geo = None
            compact = True
        self.compact_mode = compact
        
        main_widget = QWidget()
        main_layout = QVBoxLayout(main_widget)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)
        
        # Progress bar header
        self.progress_bar_widget = QFrame()
        self.progress_bar_widget.setStyleSheet("""
            QFrame { 
                background-color: #161B22; 
                border-bottom: 2px solid #30363D;
            }
        """)
        self.progress_bar_widget.setFixedHeight(44 if compact else 56)
        
        progress_layout = QVBoxLayout(self.progress_bar_widget)
        progress_layout.setContentsMargins(20, 15, 20, 15)
        
        progress_info_layout = QHBoxLayout()
        progress_title = QLabel("Installation Progress")
        progress_title.setStyleSheet("color: #1DB954; font-weight: bold; font-size: 14px;")
        
        self.progress_counter = QLabel("Step 1/12")
        self.progress_counter.setStyleSheet("color: #79C0FF; font-size: 12px;")
        
        progress_info_layout.addWidget(progress_title)
        progress_info_layout.addStretch()
        progress_info_layout.addWidget(self.progress_counter)
        progress_layout.addLayout(progress_info_layout)
        
        # Step indicators
        steps_layout = QHBoxLayout()
        self.step_indicators = []
        step_names = ["Lang", "Welcome", "Disk", "Part", "Profile", 
                     "Options", "Net", "Locale", "User", "Confirm", "Install", "Done"]
        
        for i, name in enumerate(step_names):
            step_indicator = QLabel(str(i+1))
            step_indicator.setAlignment(Qt.AlignCenter)
            step_indicator.setFixedSize(30, 30)
            step_indicator.setStyleSheet("""
                QLabel {
                    background-color: #30363D;
                    color: #8B949E;
                    border-radius: 15px;
                    font-weight: bold;
                    border: 2px solid #30363D;
                }
            """)
            step_indicator.setToolTip(name)
            self.step_indicators.append(step_indicator)
            steps_layout.addWidget(step_indicator)
        
        steps_layout.addStretch()
        self.steps_row = QWidget()
        self.steps_row.setLayout(steps_layout)
        if compact:
            self.steps_row.hide()
        progress_layout.addWidget(self.steps_row)

        main_layout.addWidget(self.progress_bar_widget)
        
        # Stacked widget
        self.stacked = QStackedWidget()
        self.stacked.setStyleSheet("QStackedWidget { background-color: #0D1117; }")
        main_layout.addWidget(self.stacked)
        
        self.setCentralWidget(main_widget)
        
        # Create screens
        screen_classes = {
            "language": LanguageSelectionScreen,
            "welcome": WelcomeScreen,
            "network": NetworkScreen,
            "disk": DiskSelectionScreen,
            "partitioning": PartitioningScreen,
            "profiles": ProfileSelectionScreen,
            "options": OptionsScreen,
            "locale": LocaleScreen,
            "user": UserScreen,
            "confirm": ConfirmScreen,
            "install": InstallationScreen,
            "done": DoneScreen,
        }
        
        self.screens = {}
        
        # Language screen first
        self.language_screen = LanguageSelectionScreen(self)
        self.screens["language"] = self.language_screen
        
        # Other screens
        for name, cls in list(screen_classes.items())[1:]:
            try:
                screen = cls(self, lang)
                self.screens[name] = screen
            except Exception as e:
                print(f"Failed to create {name} screen: {e}")
                self.screens[name] = QLabel(f"Error: {e}")
        
        for screen in self.screens.values():
            self.stacked.addWidget(screen)
        
        self.screen_names_list = list(self.screens.keys())
        self.show_screen("language")
    
    def show_screen(self, name: str):
        if name in self.screens:
            screen = self.screens[name]
            if hasattr(screen, 'on_show'):
                screen.on_show()
            self.stacked.setCurrentWidget(screen)
            
            if name in self.screen_names_list:
                current_index = self.screen_names_list.index(name)
                self.current_screen_index = current_index
                total = len(self.screen_names_list)
                self.progress_counter.setText(f"Step {current_index + 1}/{total}")
                
                for i, indicator in enumerate(self.step_indicators):
                    if i < current_index:
                        indicator.setStyleSheet("""
                            QLabel {
                                background-color: #1DB954;
                                color: #FFFFFF;
                                border-radius: 15px;
                                font-weight: bold;
                                border: 2px solid #1DB954;
                            }
                        """)
                    elif i == current_index:
                        indicator.setStyleSheet("""
                            QLabel {
                                background-color: #FFB84D;
                                color: #1A1A1A;
                                border-radius: 15px;
                                font-weight: bold;
                                border: 2px solid #FFB84D;
                            }
                        """)
                    else:
                        indicator.setStyleSheet("""
                            QLabel {
                                background-color: #30363D;
                                color: #8B949E;
                                border-radius: 15px;
                                font-weight: bold;
                                border: 2px solid #30363D;
                            }
                        """)
    
    def update_all_screens_language(self, lang: str):
        self.lang = lang
        for screen_name, screen in self.screens.items():
            if screen_name != "language" and hasattr(screen, 'update_language'):
                screen.update_language(lang)
    
    def closeApplication(self):
        reply = QMessageBox.question(self, "Confirm",
                                    "Are you sure you want to exit the installer?",
                                    QMessageBox.Yes | QMessageBox.No)
        if reply == QMessageBox.Yes:
            self.close()

def signal_handler(signum, frame):
    sig_name = signal.Signals(signum).name
    if logger:
        logger.warning(f"Received signal {sig_name}, shutting down...")
    sys.exit(0)

def cleanup_on_exit():
    if logger:
        logger.info("Installer exiting")

signal.signal(signal.SIGTERM, signal_handler)
signal.signal(signal.SIGINT, signal_handler)
if hasattr(signal, 'SIGHUP'):
    signal.signal(signal.SIGHUP, signal_handler)
atexit.register(cleanup_on_exit)

if __name__ == "__main__":
    try:
        if logger:
            logger.info("Initializing QApplication...")

        lang = "ru" if os.environ.get("LANG", "").startswith("ru") else "en"

        # Enable HiDPI scaling for high-resolution displays (4K, HiDPI)
        # CRITICAL FIX: Must be set BEFORE QApplication creation
        os.environ.setdefault("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
        os.environ.setdefault("QT_ENABLE_HIGHDPI_SCALING", "1")
        os.environ.setdefault("QT_SCALE_FACTOR_ROUNDING_POLICY", "RoundPreferFloor")
        os.environ.setdefault("QT_X11_NO_MITSHM", "1")
        os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

        # Create QApplication FIRST before setting attributes
        app = QApplication(sys.argv)
        
        # Enable HighDPI attributes AFTER creating QApplication but BEFORE any widgets
        try:
            QApplication.setAttribute(Qt.AA_EnableHighDpiScaling, True)
        except AttributeError:
            pass  # Qt6 has this enabled by default
        try:
            QApplication.setAttribute(Qt.AA_UseHighDpiPixmaps, True)
        except AttributeError:
            pass
        
        # Set Fusion style for consistent cross-platform appearance
        app.setStyle("Fusion")
        
        # Set default font with better HiDPI support
        default_font = QFont("Sans", 11)
        default_font.setHintingPreference(QFont.PreferFullHinting)
        app.setFont(default_font)
        
        if logger:
            logger.info("QApplication initialized with HiDPI support")

        window = InstallerApp(lang)
        window.showFullScreen()
        window.raise_()
        window.activateWindow()

        if logger:
            logger.info("Starting Qt event loop")
        exit_code = app.exec_()
        sys.exit(exit_code)

    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as e:
        print(f"FATAL ERROR: {e}", file=sys.stderr)
        if logger:
            logger.exception("Fatal error")
        sys.exit(1)
