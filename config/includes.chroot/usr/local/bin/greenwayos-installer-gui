# ── Pre-Initialization System Checks ───────────────────────────────────────────────────
if not os.environ.get('LANG'):
    os.environ['LANG'] = 'ru_RU.UTF-8'
if not os.environ.get('LC_ALL'):
    os.environ['LC_ALL'] = os.environ.get('LANG', 'C.UTF-8')

LOG_DIR = "/var/log"
LOG_FILE = os.path.join(LOG_DIR, "greenwayos-installer-debug.log")

try:
    Path(LOG_DIR).mkdir(parents=True, exist_ok=True)
    Path(LOG_FILE).touch()
except Exception as e:
    print(f"WARNING: Cannot write to {LOG_FILE}, using /tmp: {e}", file=sys.stderr)
    LOG_FILE = f"/tmp/greenwayos-installer-debug-{os.getpid()}.log"
    try:
        Path(LOG_FILE).touch()
    except Exception as e2:
        print(f"CRITICAL: Cannot write logs anywhere: {e2}", file=sys.stderr)
        LOG_FILE = None

try:
    handlers = [logging.StreamHandler(sys.stdout)]
    if LOG_FILE:
        handlers.append(logging.FileHandler(LOG_FILE))
    
    logging.basicConfig(
        level=logging.DEBUG,
        format='%(asctime)s [%(levelname)s] %(message)s',
        handlers=handlers
    )
    logger = logging.getLogger(__name__)
    logger.info("=== GreenWayOS Installer Started ===")
    logger.info(f"Python: {sys.version}")
    logger.info(f"DISPLAY: {os.environ.get('DISPLAY', 'NOT SET')}")
    logger.info(f"XAUTHORITY: {os.environ.get('XAUTHORITY', 'NOT SET')}")
    logger.info(f"LANG: {os.environ.get('LANG', 'NOT SET')}")
    logger.info(f"HOME: {os.environ.get('HOME', 'NOT SET')}")
    logger.info(f"CWD: {os.getcwd()}")
    logger.info(f"Log file: {LOG_FILE}")
except Exception as e:
    print(f"ERROR: Failed to setup logging: {e}", file=sys.stderr)
    logger = None

if not os.environ.get('DISPLAY'):
    error_msg = "ERROR: DISPLAY not set. X11 server not available."
    print(error_msg, file=sys.stderr)
    if logger:
        logger.error(error_msg)
    sys.exit(1)

try:
    from PyQt5.QtWidgets import (
        QApplication, QMainWindow, QStackedWidget, QWidget, QVBoxLayout, QHBoxLayout,
        QPushButton, QLabel, QLineEdit, QComboBox, QCheckBox, QTableWidget, QTableWidgetItem,
        QProgressBar, QTextEdit, QMessageBox, QSpinBox, QRadioButton, QButtonGroup,
        QGroupBox, QListWidget, QListWidgetItem, QHeaderView, QSizePolicy, QScrollArea,
        QFrame, QGridLayout, QMenu, QDialog
    )
    from PyQt5.QtCore import Qt, QThread, pyqtSignal, QSize, QPropertyAnimation, QEasingCurve, QRect
    from PyQt5.QtGui import QFont, QColor, QPixmap, QIcon, QLinearGradient
    if logger:
        logger.info("PyQt5 modules imported successfully")
except ImportError as e:
    error_msg = f"ERROR: PyQt5 not found. Install with: apt-get install -y python3-pyqt5. Details: {e}"
    print(error_msg, file=sys.stderr)
    if logger:
        logger.error(error_msg)
    sys.exit(1)

