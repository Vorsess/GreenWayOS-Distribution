class DiskSelectionScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.selected_disk = None
        self.disks = []
        self.disk_cards = {}
        self.disks_loaded = False
        self._disk_loading = False
        self.setup_ui()
    
    def create_disk_card(self, disk: DiskInfo) -> QFrame:
        compact = getattr(self.parent, "compact_mode", False)
        card = create_card_frame(compact)
        card.setCursor(Qt.PointingHandCursor)

        layout = QVBoxLayout(card)
        pad = 12 if compact else 16
        layout.setContentsMargins(pad, pad, pad, pad)
        layout.setSpacing(8 if compact else 10)
        
        top_layout = QHBoxLayout()
        
        dev_label = QLabel(str(disk.device) if disk.device else "Unknown")
        dev_font = QFont("Sans", 13, QFont.Bold)
        dev_label.setFont(dev_font)
        dev_label.setStyleSheet("color: #1DB954;")
        top_layout.addWidget(dev_label)
        
        top_layout.addStretch()
        
        ok = True
        try:
            ok, _msg, _disk_size = check_disk_space(disk.device if disk.device else "/dev/null")
            status_color = "#1DB954" if ok else "#FF6B6B"
            status_text = "✓ Ready" if ok else "✗ Too Small"
        except Exception:
            ok = False
            status_color = "#FFB84D"
            status_text = "⚠ Check"
        
        status_label = QLabel(status_text)
        status_label.setFont(QFont("Sans", 10, QFont.Bold))
        status_label.setStyleSheet(f"color: {status_color};")
        top_layout.addWidget(status_label)
        
        layout.addLayout(top_layout)
        
        model_str = str(disk.model if disk.model else "Unknown")[:45]
        model_label = QLabel(f"📦 {model_str}")
        model_label.setFont(QFont("Sans", 10))
        model_label.setStyleSheet("color: #AAA;")
        layout.addWidget(model_label)
        
        try:
            size_gb = float(disk.size_gb) if disk.size_gb else 0
            size_label = QLabel(f"💾 {size_gb:.1f} GB")
        except:
            size_label = QLabel(f"💾 Unknown Size")
        size_label.setFont(QFont("Sans", 11, QFont.Bold))
        size_label.setStyleSheet("color: #79C0FF;")
        layout.addWidget(size_label)
        
        part_count = len(disk.partitions) if disk.partitions else 0
        if part_count > 0:
            part_label = QLabel(f"🗂️  {part_count} partition(s)")
            part_label.setFont(QFont("Sans", 10))
            part_label.setStyleSheet("color: #BBB;")
            layout.addWidget(part_label)
        else:
            free_label = QLabel("✓ " + get_text("unallocated", self.lang))
            free_label.setFont(QFont("Sans", 10))
            free_label.setStyleSheet("color: #1DB954;")
            layout.addWidget(free_label)
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(10)
        
        btn_select = QPushButton("Select")
        btn_select.setObjectName("primaryBtn")
        btn_select.setMinimumHeight(32)
        btn_select.setCursor(Qt.PointingHandCursor)
        btn_select.clicked.connect(lambda: self.select_disk(disk, card))
        btn_layout.addWidget(btn_select)
        
        layout.addLayout(btn_layout)
        
        separator = QFrame()
        separator.setFrameShape(QFrame.HLine)
        separator.setStyleSheet("color: #30363D;")
        layout.addWidget(separator)
        
        card.disk = disk
        card.is_valid = ok
        
        return card
    
    def setup_ui(self):
        compact = getattr(self.parent, "compact_mode", False)
        screen = QApplication.primaryScreen()
        # Use availableGeometry instead of geometry to account for taskbars/panels
        geo = screen.availableGeometry() if screen else None
        if geo is not None and (geo.height() < 900 or geo.width() < 1280):
            compact = True
        margin = 16 if compact else 24
        title_size = 18 if compact else 22

        layout = QVBoxLayout()
        layout.setContentsMargins(margin, margin, margin, margin)
        layout.setSpacing(12 if compact else 16)

        title = QLabel(get_text("select_disk", self.lang))
        title.setFont(QFont("Sans", title_size, QFont.Bold))
        title.setStyleSheet("color: #1DB954;")
        layout.addWidget(title)

        scroll = QScrollArea()
        scroll.setStyleSheet("background-color: transparent; border: none;")
        scroll.setWidgetResizable(True)
        scroll.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self.disks_container = QWidget()
        self.disks_layout = QVBoxLayout(self.disks_container)
        self.disks_layout.setSpacing(12)

        loading_label = QLabel("⏳ Обнаружение дисков... / Detecting disks...")
        loading_label.setAlignment(Qt.AlignCenter)
        loading_label.setStyleSheet("color: #79C0FF; font-size: 15px; font-weight: bold; padding: 14px;")
        self.disks_layout.addWidget(loading_label)
        self.disks_layout.addStretch()

        scroll.setWidget(self.disks_container)
        layout.addWidget(scroll, 1)

        self.details_text = QTextEdit()
        self.details_text.setReadOnly(True)
        self.details_text.setMaximumHeight(72 if compact else 96)
        self.details_text.setStyleSheet("background-color: #1A1A1A; color: #1DB954; border: 1px solid #444; border-radius: 6px;")
        layout.addWidget(self.details_text)

        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(12)

        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.setMinimumHeight(44 if compact else 52)
        btn_back.clicked.connect(lambda: self.parent.show_screen("network"))
        btn_layout.addWidget(btn_back)

        btn_layout.addStretch()

        btn_next = create_gradient_button(get_text("next", self.lang), "primary", "→")
        btn_next.setMinimumHeight(44 if compact else 52)
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)

        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def on_show(self):
        if not self.disks_loaded and not self._disk_loading:
            from PyQt5.QtCore import QTimer
            # Allow block devices to settle after X11 start (VMware/slow udev)
            QTimer.singleShot(800, self.load_disks_sync)

    def load_disks_sync(self):
        if self._disk_loading:
            return
        self._disk_loading = True
        QApplication.setOverrideCursor(Qt.WaitCursor)
        try:
            # First ensure udev has settled (critical for VM/hotplug disks)
            import subprocess
            try:
                subprocess.run(
                    ["udevadm", "settle", "--timeout=5"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=8,
                    check=False,
                )
            except Exception:
                pass
            
            # Retry disk detection multiple times with delays (matches text installer behavior)
            self.disks = []
            for attempt in range(3):
                if attempt > 0:
                    time.sleep(1.5)  # Wait between attempts
                self.disks = get_disks()
                if self.disks:
                    break
            
            self.disks_loaded = True
            if logger:
                logger.info("Disk detection completed: %d disk(s) found", len(self.disks))
        except Exception as exc:
            if logger:
                logger.exception("Disk detection failed")
            self.disks = []
            self.disks_loaded = True
        finally:
            self._disk_loading = False
            QApplication.restoreOverrideCursor()
        self.rebuild_disk_ui()
    
    def rebuild_disk_ui(self):
        while self.disks_layout.count():
            item = self.disks_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        
        self.disk_cards = {}
        
        if self.disks:
            for disk in self.disks:
                try:
                    card = self.create_disk_card(disk)
                    self.disk_cards[disk.device] = card
                    self.disks_layout.addWidget(card)
                except Exception as e:
                    if logger:
                        logger.exception("Error creating disk card for %s", disk.device)
                    error_label = QLabel(f"❌ Error loading disk {disk.device}: {str(e)}")
                    error_label.setStyleSheet("color: #FF6B6B; font-size: 13px; padding: 10px;")
                    error_label.setWordWrap(True)
                    self.disks_layout.addWidget(error_label)
        else:
            no_disks_label = QLabel(
                "⚠️ Диски не найдены / No disks found\n\n"
                "Возможные причины / Possible reasons:\n"
                "• Физический диск не подключён / No physical disk connected\n"
                "• Неправильные настройки BIOS/UEFI / Incorrect BIOS/UEFI settings\n"
                "• Диск используется другой ОС / Disk in use by another OS\n\n"
                "Нажмите 'Обновить' для повторной попытки / Click 'Refresh' to retry"
            )
            no_disks_label.setAlignment(Qt.AlignCenter)
            no_disks_label.setStyleSheet("color: #FFB84D; font-size: 14px; font-weight: bold; padding: 24px;")
            no_disks_label.setWordWrap(True)
            
            refresh_btn = QPushButton("🔄 Обновить список дисков / Refresh Disk List")
            refresh_btn.setObjectName("primaryBtn")
            refresh_btn.setMinimumHeight(52)
            refresh_btn.setMinimumWidth(280)
            refresh_btn.setFont(QFont("JetBrains Mono", 11, QFont.Bold))
            refresh_btn.clicked.connect(self.refresh_and_reload)
            
            self.disks_layout.addWidget(no_disks_label)
            self.disks_layout.addSpacing(24)
            self.disks_layout.addWidget(refresh_btn)
            self.disks_layout.addStretch()
    
    def select_disk(self, disk: DiskInfo, card: QFrame):
        for card_widget in self.disk_cards.values():
            card_widget.setStyleSheet(COMPONENT_STYLES["card_widget"])
        
        selected_style = """
            QFrame {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                    stop:0 #1DB954, stop:1 #1A6B3A);
                border: 3px solid #1ED760;
                border-radius: 12px;
                padding: 20px;
            }
        """
        card.setStyleSheet(selected_style)
        
        self.selected_disk = disk
        
        details = f"Device: {disk.device}\nSize: {disk.size_gb:.1f} GB\nModel: {disk.model}\n\n"
        if disk.partitions:
            details += f"Partitions ({len(disk.partitions)}):\n"
            for part in disk.partitions[:8]:
                details += f"  • {part}\n"
            details += "\nQuick install will erase the whole disk."
        else:
            unalloc = get_text("unallocated", self.lang)
            details += f"✓ {unalloc} — ready for installation\n"
        
        self.details_text.setText(details)
    
    def on_next(self):
        if not self.selected_disk:
            QMessageBox.warning(self, get_text("error", self.lang),
                              "Please select a disk" if self.lang == "en" else "Пожалуйста, выберите диск")
            return
        
        ok, msg, _ = check_disk_space(self.selected_disk.device)
        if not ok:
            QMessageBox.critical(self, get_text("error", self.lang), msg)
            return
        
        self.parent.state["disk"] = self.selected_disk.device
        self.parent.show_screen("partitioning")
    
    def refresh_and_reload(self):
        """Refresh disk list with udev settle and retry logic."""
        if logger:
            logger.info("Manual disk refresh requested")
        self.disks_loaded = False
        # Show loading state immediately
        self.rebuild_disk_ui()
        # Reload disks after a short delay to allow UI update
        from PyQt5.QtCore import QTimer
        QTimer.singleShot(300, self.load_disks_sync)
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()
        if self.disks_loaded:
            self.rebuild_disk_ui()

class PartitioningScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.setup_ui()
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        
        title = QLabel(get_text("partitioning", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        layout.addWidget(title)
        
        boot_group = QGroupBox(get_text("boot_mode", self.lang))
        boot_layout = QVBoxLayout()
        self.boot_mode = QButtonGroup()
        
        radio_auto = QRadioButton(get_text("auto_detect", self.lang))
        radio_auto.setChecked(True)
        radio_bios = QRadioButton(get_text("bios", self.lang))
        radio_uefi = QRadioButton(get_text("uefi", self.lang))
        
        self.boot_mode.addButton(radio_auto, 0)
        self.boot_mode.addButton(radio_bios, 1)
        self.boot_mode.addButton(radio_uefi, 2)
        
        boot_layout.addWidget(radio_auto)
        boot_layout.addWidget(radio_bios)
        boot_layout.addWidget(radio_uefi)
        boot_group.setLayout(boot_layout)
        layout.addWidget(boot_group)
        
        part_group = QGroupBox(get_text("partition_table", self.lang))
        part_layout = QVBoxLayout()

        radio_quick = QRadioButton(get_text("quick_format", self.lang))
        radio_quick.setChecked(True)
        radio_dual = QRadioButton(get_text("dualboot_format", self.lang))
        radio_manual = QRadioButton(get_text("manual_partition", self.lang))
        radio_manual.setEnabled(False)

        self.partition_method = QButtonGroup()
        self.partition_method.addButton(radio_quick, 0)
        self.partition_method.addButton(radio_dual, 1)
        self.partition_method.addButton(radio_manual, 2)

        part_layout.addWidget(radio_quick)
        part_layout.addWidget(radio_dual)
        part_layout.addWidget(radio_manual)

        self.dualboot_hint = QLabel("")
        self.dualboot_hint.setWordWrap(True)
        self.dualboot_hint.setStyleSheet("color: #7A8B9A;")
        part_layout.addWidget(self.dualboot_hint)

        part_group.setLayout(part_layout)
        layout.addWidget(part_group)

        self._refresh_dualboot_hint()
        radio_dual.toggled.connect(lambda _=False: self._refresh_dualboot_hint())
        self.boot_mode.buttonClicked.connect(lambda _=None: self._refresh_dualboot_hint())
        
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_back = create_gradient_button(get_text("back", self.lang), "secondary", "←")
        btn_back.clicked.connect(lambda: self.parent.show_screen("disk"))
        btn_layout.addWidget(btn_back)
        
        btn_layout.addStretch()
        
        btn_next = create_gradient_button(get_text("next", self.lang), "primary", "→")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)

    def _resolve_boot_mode(self) -> str:
        boot_id = self.boot_mode.checkedId()
        if boot_id == 0:
            return detect_boot_mode()
        if boot_id == 1:
            return "bios"
        return "uefi"

    def _refresh_dualboot_hint(self):
        disk = self.parent.state.get("disk")
        boot = self._resolve_boot_mode()
        if not disk:
            self.dualboot_hint.setText("")
            return
        ok, msg, info = assess_dualboot(disk, boot)
        free_gb = info.get("free_gb")
        free_txt = f"{free_gb:.1f} GB free" if free_gb else "no free space"
        esp = info.get("esp") or "no ESP"
        if ok:
            self.dualboot_hint.setText(f"OK: ESP={esp}, {free_txt}")
            self.dualboot_hint.setStyleSheet("color: #1DB954;")
        else:
            self.dualboot_hint.setText(msg)
            self.dualboot_hint.setStyleSheet("color: #FFB020;")

    def on_next(self):
        boot_mode = self._resolve_boot_mode()
        self.parent.state["boot_mode"] = boot_mode

        method_id = self.partition_method.checkedId()
        if method_id == 1:
            disk = self.parent.state.get("disk")
            ok, msg, _info = assess_dualboot(disk or "", boot_mode)
            if boot_mode != "uefi":
                QMessageBox.warning(self, get_text("error", self.lang),
                                    get_text("dualboot_need_uefi", self.lang))
                return
            if not ok:
                QMessageBox.warning(
                    self,
                    get_text("error", self.lang),
                    msg or get_text("dualboot_not_ready", self.lang),
                )
                return
            self.parent.state["partition_method"] = "dualboot"
        else:
            self.parent.state["partition_method"] = "quick"

        self.parent.show_screen("profiles")

    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

class ProfileSelectionScreen(QWidget):
    def __init__(self, parent, lang="en"):
        super().__init__()
        self.parent = parent
        self.lang = lang
        self.selected_profile = None
        self.profile_cards = {}
        self.setup_ui()
    
    def create_profile_card(self, profile_id: str, profile_data: Dict) -> QFrame:
        card = QFrame()
        card.setStyleSheet(COMPONENT_STYLES["card_widget"])
        card.setMinimumHeight(180)
        card.setCursor(Qt.PointingHandCursor)
        
        layout = QVBoxLayout(card)
        layout.setContentsMargins(25, 20, 25, 20)
        layout.setSpacing(12)
        
        icon_label = QLabel(profile_data['icon'])
        icon_font = QFont("Arial", 56)
        icon_label.setFont(icon_font)
        icon_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(icon_label)
        
        name_label = QLabel(get_text(profile_data['name'], self.lang))
        name_font = QFont("Sans", 14, QFont.Bold)
        name_label.setFont(name_font)
        name_label.setAlignment(Qt.AlignCenter)
        name_label.setStyleSheet("color: #1DB954;")
        layout.addWidget(name_label)
        
        desc_label = QLabel(get_text(profile_data['desc'], self.lang))
        desc_label.setFont(QFont("Sans", 10))
        desc_label.setAlignment(Qt.AlignCenter)
        desc_label.setStyleSheet("color: #AAA; margin: 5px 0;")
        desc_label.setWordWrap(True)
        layout.addWidget(desc_label)
        
        packages = get_profile_packages(profile_id)
        pkg_label = QLabel(f"📦 {len(packages)} packages")
        pkg_label.setFont(QFont("Sans", 9))
        pkg_label.setAlignment(Qt.AlignCenter)
        pkg_label.setStyleSheet("color: #79C0FF;")
        layout.addWidget(pkg_label)
        
        card.profile_id = profile_id
        card.mousePressEvent = lambda e: self.select_profile(profile_id, card)
        
        return card
    
    def setup_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(40, 40, 40, 40)
        layout.setSpacing(30)
        
        title = QLabel(get_text("select_profile", self.lang))
        title.setFont(QFont("Sans", 24, QFont.Bold))
        title.setStyleSheet("color: #1DB954;")
        layout.addWidget(title)
        
        cards_layout = QGridLayout()
        cards_layout.setSpacing(20)
        
        profile_ids = list(PROFILES.keys())
        for i, profile_id in enumerate(profile_ids):
            card = self.create_profile_card(profile_id, PROFILES[profile_id])
            self.profile_cards[profile_id] = card
            cards_layout.addWidget(card, 0, i)
        
        layout.addLayout(cards_layout)
        layout.addStretch()
        
        btn_layout = QHBoxLayout()
        btn_layout.setSpacing(15)
        
        btn_back = create_gradient_button(get_text("back", self.lang), "secondary")
        btn_back.clicked.connect(lambda: self.parent.show_screen("partitioning"))
        btn_layout.addWidget(btn_back)
        
        btn_layout.addStretch()
        
        btn_next = create_gradient_button(get_text("next", self.lang), "primary")
        btn_next.clicked.connect(self.on_next)
        btn_layout.addWidget(btn_next)
        
        layout.addLayout(btn_layout)
        self.setLayout(layout)
    
    def select_profile(self, profile_id: str, card: QFrame):
        for card_widget in self.profile_cards.values():
            card_widget.setStyleSheet(COMPONENT_STYLES["card_widget"])
        
        selected_style = """
            QFrame {
                background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                    stop:0 #1DB954, stop:1 #1A6B3A);
                border: 3px solid #1ED760;
                border-radius: 12px;
                padding: 20px;
            }
        """
        card.setStyleSheet(selected_style)
        self.selected_profile = profile_id
    
    def on_next(self):
        if not self.selected_profile:
            QMessageBox.warning(self, get_text("error", self.lang),
                              get_text("error_select_profile", self.lang))
            return
        
        self.parent.state["profile"] = self.selected_profile
        self.parent.state["packages"] = get_profile_packages(self.selected_profile)
        self.parent.show_screen("options")
    
    def update_language(self, lang: str):
        self.lang = lang
        self.setup_ui()

