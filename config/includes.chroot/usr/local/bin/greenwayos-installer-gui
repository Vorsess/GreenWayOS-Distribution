def create_gradient_button(text: str, btn_type: str = "primary", icon_text: str = "") -> QPushButton:
    label = f"{'  ' + icon_text + '  ' if icon_text else ''}{text}"
    btn = QPushButton(label)
    btn.setMinimumHeight(56)  # Increased from 45px for better touch/click accuracy on HiDPI
    btn.setMinimumWidth(140)  # Added minimum width for better visibility
    btn.setFont(QFont("JetBrains Mono", 11, QFont.Bold))  # Increased font size from 10 to 11
    if btn_type == "primary":
        btn.setStyleSheet(COMPONENT_STYLES["gradient_button_primary"])
    else:
        btn.setStyleSheet(COMPONENT_STYLES["gradient_button_secondary"])
    btn.setCursor(Qt.PointingHandCursor)
    return btn

