def get_text(key: str, lang: str = "en") -> str:
    return STRINGS.get(lang, STRINGS["en"]).get(key, key)

_INSTALL_ROOT = "/usr/local/lib/greenwayos"
if os.path.isdir(_INSTALL_ROOT) and _INSTALL_ROOT not in sys.path:
    sys.path.insert(0, _INSTALL_ROOT)

from install.disk import (  # noqa: E402
    assess_dualboot,
    check_disk_space,
    detect_boot_mode,
    get_disks as _get_disks_shared,
    get_live_boot_disk,
    list_disk_partitions,
    parse_size_human,
)
from install.network import (  # noqa: E402
    check_internet as _check_internet_shared,
    connect_wifi,
    network_status_summary,
    scan_wifi,
)

# ── Backend Utilities ──────────────────────────────────────────────

class DiskInfo:
    def __init__(self, device: str, size_gb: float, model: str, disk_type: str = "disk"):
        self.device = device
        self.size_gb = size_gb
        self.model = model
        self.disk_type = disk_type
        self.partitions: List[str] = []
    
    def __str__(self):
        return f"{self.device} ({self.size_gb:.1f}GB) - {self.model}"


def get_disks() -> List[DiskInfo]:
    """Same disk backend as the text installer (install.disk)."""
    disks: List[DiskInfo] = []
    for dev, size_str, model in _get_disks_shared():
        size_gb = parse_size_human(size_str)
        if size_gb <= 0:
            ok, _, size_gb = check_disk_space(dev, required_gb=0)
            if not ok or size_gb <= 0:
                continue
        # Match text installer: show any real disk (>= 1 GiB); install min checked later
        if size_gb < 1:
            continue
        info = DiskInfo(dev, size_gb, model or "Unknown")
        try:
            info.partitions = list_disk_partitions(dev)
        except Exception:
            info.partitions = []
        disks.append(info)

    if logger:
        logger.info("GUI detected %d disk(s): %s", len(disks), [d.device for d in disks])
    return disks


def get_available_ram() -> float:
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal"):
                    kb = int(line.split()[1])
                    return kb / (1024 * 1024)
    except Exception:
        pass
    return 0

def check_internet() -> bool:
    return _check_internet_shared("8.8.8.8", count=1, timeout=3)

def get_profile_packages(profile: str) -> Dict[str, list]:
    packages = {
        "standard": [
            "gnome-core", "gdm3", "firefox-esr", "thunderbird",
            "libreoffice", "vlc", "gimp", "network-manager-gnome"
        ],
        "engineering": [
            "build-essential", "git", "docker.io", "docker-compose",
            "python3-dev", "python3-pip", "golang-go", "nodejs", "npm",
            "prometheus", "grafana", "postgresql", "nginx"
        ],
        "security": [
            "aide", "auditd", "fail2ban", "apparmor", "apparmor-profiles",
            "lynis", "nikto", "nmap", "wireshark",
            "openssl", "gnupg", "cryptsetup", "ufw"
        ]
    }
    return packages.get(profile, packages["standard"])

PROFILES = {
    "standard": {"name": "profile_standard", "desc": "profile_standard_desc", "icon": "💼"},
    "engineering": {"name": "profile_engineering", "desc": "profile_engineering_desc", "icon": "⚙️"},
    "security": {"name": "profile_security", "desc": "profile_security_desc", "icon": "🔒"}
}

RESERVED_USERNAMES = {"root", "admin", "bin", "daemon", "sys", "sync", "games", "man", 
                       "lp", "mail", "uucp", "proxy", "www-data", "backup", "list", 
                       "irc", "gnats", "nobody", "systemd-network", "systemd-resolve"}

def validate_hostname(hostname: str) -> Tuple[bool, str]:
    if not hostname:
        return True, ""
    if len(hostname) > 63:
        return False, "Hostname too long (max 63 chars)"
    if not all(c.isalnum() or c in "-" for c in hostname):
        return False, "Only alphanumeric and hyphens allowed"
    if hostname.startswith("-") or hostname.endswith("-"):
        return False, "Cannot start or end with hyphen"
    return True, ""

def validate_username(username: str) -> Tuple[bool, str]:
    if not username:
        return False, "Username cannot be empty"
    if len(username) < 3 or len(username) > 32:
        return False, "Username must be 3-32 characters"
    if not all(c.isalnum() or c == "_" for c in username):
        return False, "Only alphanumeric and underscore allowed"
    if username in RESERVED_USERNAMES:
        return False, f"'{username}' is a reserved system username"
    return True, ""

def check_password_strength(password: str) -> Tuple[str, int]:
    score = 0
    if len(password) >= 8:
        score += 1
    if len(password) >= 12:
        score += 1
    if any(c.isupper() for c in password):
        score += 1
    if any(c.islower() for c in password):
        score += 1
    if any(c.isdigit() for c in password):
        score += 1
    if any(c in "!@#$%^&*()-_=+[]{}|;:,.<>?/~`" for c in password):
        score += 2
    
    if score < 3:
        return "weak", score
    elif score < 5:
        return "medium", score
    else:
        return "strong", score

def save_config(config: Dict, filepath: str = "/root/.greenwayos-installer.conf") -> bool:
    try:
        with open(filepath, 'w') as f:
            json.dump(config, f, indent=2)
        return True
    except Exception:
        return False

def load_config(filepath: str = "/root/.greenwayos-installer.conf") -> Optional[Dict]:
    try:
        with open(filepath, 'r') as f:
            return json.load(f)
    except Exception:
        return None

