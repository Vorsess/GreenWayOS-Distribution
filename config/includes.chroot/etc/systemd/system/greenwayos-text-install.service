[Unit]
Description=GreenWayOS text installer (tty1)
ConditionKernelCommandLine=greenwayos.install=1
ConditionKernelCommandLine=!greenwayos.gui_install=1
After=greenwayos-install-banner.service greenwayos-install-flags.service systemd-user-sessions.service basic.target
Wants=greenwayos-install-banner.service
Before=lightdm.service
Conflicts=greenwayos-gui-install.service lightdm.service getty@tty1.service
# Claim tty1 before getty can take it (login prompt / "username:")
IgnoreOnIsolate=yes

[Service]
Type=simple
User=root
Environment=TERM=linux
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Unset so launch script does not skip openvt recovery incorrectly
UnsetEnvironment=GREENWAYOS_INSTALLER_VIA_OPENVT
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
# curses needs a real TTY on stdin/out/err (journal breaks the UI)
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStartPre=-/bin/sh -c 'systemctl stop getty@tty1.service 2>/dev/null || true'
ExecStartPre=-/bin/sh -c 'command -v chvt >/dev/null && chvt 1 || true'
ExecStartPre=/usr/local/bin/greenwayos-setup-install-console.sh
ExecStart=/usr/local/bin/greenwayos-installer
Restart=on-failure
RestartSec=2
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
