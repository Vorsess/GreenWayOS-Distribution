#!/bin/bash
# chroot hook: Final branding for GreenWayOS
set -euo pipefail

# Error handling
trap 'echo "[ERROR] Hook failed at line $LINENO"; exit 1' ERR

echo "[✓] Customizing OS branding..."

# Override os-release
cat > /etc/os-release << 'EOF'
PRETTY_NAME="GreenWayOS 2.0 (ctOS)"
NAME="GreenWayOS"
ID=greenwayos
ID_LIKE=debian
VERSION_ID="2.0"
VERSION="2.0-rc1 (ctOS HUD)"
VERSION_CODENAME=bookworm
ANSI_COLOR="1;36"
HOME_URL="https://github.com/Vorsess"
GREENWAYOS_CREATOR="Sergey Karamyshev"
GREENWAYOS_GITHUB="Vorsess"
GREENWAYOS_EDITION="ctOS"
EOF

# Override lsb-release
cat > /etc/lsb-release << 'EOF'
DISTRIB_ID=GreenWayOS
DISTRIB_RELEASE=2.0
DISTRIB_CODENAME=bookworm
DISTRIB_DESCRIPTION="GreenWayOS 2.0 ctOS HUD"
EOF

# Override issue (the text before login)
echo "GreenWayOS 2.0 ctOS \\n \\l" > /etc/issue
echo "GreenWayOS 2.0 ctOS" > /etc/issue.net
echo "GreenWayOS 2.0 // SYSTEM ONLINE" > /etc/motd

if [ -f /etc/os-release ] && grep -q GreenWayOS /etc/os-release; then
    echo "[✓] os-release configured"
else
    echo "[⚠] WARNING: os-release verification failed" >&2
fi

echo "[✓] Branding customization completed"

# Enable installer systemd units (activation gated by /run/greenwayos/* flags)
mkdir -p /etc/systemd/system/sysinit.target.wants
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf ../greenwayos-install-flags.service /etc/systemd/system/sysinit.target.wants/greenwayos-install-flags.service
ln -sf ../greenwayos-install-banner.service /etc/systemd/system/multi-user.target.wants/greenwayos-install-banner.service
ln -sf ../greenwayos-live-display.service /etc/systemd/system/graphical.target.wants/greenwayos-live-display.service 2>/dev/null || true
ln -sf ../greenwayos-gui-install.service /etc/systemd/system/multi-user.target.wants/greenwayos-gui-install.service
ln -sf ../greenwayos-text-install.service /etc/systemd/system/multi-user.target.wants/greenwayos-text-install.service
echo "[✓] Installer systemd units linked (flags + banner + installers)"

# Best-effort live shutdown cleanup (helps with /run/live/medium busy on some systems)
mkdir -p /etc/systemd/system/shutdown.target.wants
ln -sf ../greenwayos-live-shutdown.service /etc/systemd/system/shutdown.target.wants/greenwayos-live-shutdown.service
echo "[✓] Live shutdown cleanup unit linked to shutdown.target"
